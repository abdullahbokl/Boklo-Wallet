rules_version = '2';

// The client app does not use Cloud Storage today. Keep the bucket fully
// locked until a feature needs it, then open ONLY narrowly-scoped,
// owner-checked paths, e.g.:
//   match /users/{userId}/{allPaths=**} {
//     allow read, write: if request.auth != null && request.auth.uid == userId
//                        && request.resource.size < 5 * 1024 * 1024;
//   }
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
